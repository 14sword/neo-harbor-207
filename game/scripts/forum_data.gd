func _post(title: String, author: String, time: String, content: String) -> Dictionary:
	return {
		"title": title,
		"author": author,
		"time": time,
		"content": content,
	}

func get_posts(category: String, phase: String) -> Array:
	var result = []
	if _posts.has(category) and _posts[category].has(phase):
		result.append_array(_posts[category][phase])
	if _tree_has_node("/root/DailyWorldGenerator"):
		var dwg = _tree_get_node("/root/DailyWorldGenerator")
		if dwg and dwg.has_method("get_daily_forum_posts"):
			result.append_array(dwg.get_daily_forum_posts(category, phase))
	return result

func get_phase_key() -> String:
	if _tree_has_node("/root/DayNightManager"):
		var dnm = _tree_get_node("/root/DayNightManager")
		match dnm.current_phase:
			dnm.DayPhase.DAY, dnm.DayPhase.DUSK:
				return "day"
			dnm.DayPhase.RAIN_NIGHT:
				return "rain"
			dnm.DayPhase.NIGHT:
				return "night"
	return "day"

func _tree_has_node(path: String) -> bool:
	var ml = Engine.get_main_loop()
	if ml == null:
		return false
	return ml.root.has_node(path)

func _tree_get_node(path: String) -> Node:
	var ml = Engine.get_main_loop()
	if ml == null:
		return null
	return ml.root.get_node(path)
