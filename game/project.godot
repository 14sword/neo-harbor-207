; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Neo Harbor 207"
run/main_scene="res://scenes/character_select.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Config="*res://scripts/config.gd"
APIClient="*res://scripts/api_client.gd"
LogPanel="*res://scripts/log_panel.gd"
AudioManager="*res://scripts/audio_manager.gd"
DayNightManager="*res://scripts/day_night_manager.gd"
FootstepGenerator="*res://scripts/footstep_generator.gd"
SaveManager="*res://scripts/save_manager.gd"
QuestManager="*res://scripts/quest_manager.gd"
SceneManager="*res://scripts/scene_manager.gd"
EnvironmentManager="*res://scripts/environment_manager.gd"
GameManager="*res://scripts/game_manager.gd"
PetManager="*res://scripts/pet_manager.gd"
UIThemeManager="*res://scripts/ui_theme_manager.gd"
WorldCalendar="*res://scripts/world_calendar.gd"
MediaManager="*res://scripts/media_manager.gd"
DailyWorldGenerator="*res://scripts/daily_world_generator.gd"
WeatherEffects="*res://scripts/weather_effects.gd"
CharacterClassManager="*res://scripts/character_class_manager.gd"
StoryManager="*res://scripts/story_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

